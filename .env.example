# AI-Powered Video Generator Configuration
# Copy this file to .env and fill in your actual API keys

# Google Gemini API Key (Required for AI script generation)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key (Required for stock videos and photos)
# Obtain from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ElevenLabs API Key (Optional: for ultra-realistic AI voiceovers)
# If left empty, the application automatically uses Google Text-to-Speech (gTTS)
# Obtain from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Application Defaults
DEFAULT_VIDEO_DURATION=15
DEFAULT_ASPECT_RATIO=9:16
STREAMLIT_THEME=dark_blue
